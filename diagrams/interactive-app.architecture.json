  "cards": [
    {
      "dot": "rose",
      "title": "One token, two halves",
      "items": [
        "Verified Auth0 issuer + immutable sub bind to users.auth0_sub",
        "Token email claims never select a mailbox",
        "Worker APIs verify one Auth0 token consistently"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cross-origin hop",
      "items": [
        "Workers run a CORS allowlist",
        "Cookie-Web CSP must permit https://*.infinitywave.online in connect-src",
        "Worker routes use clean paths on ten custom domains"
      ]
    },
    {
      "dot": "emerald",
      "title": "No direct data access",
      "items": [
        "Browser and iOS never talk to Postgres directly",
        "Search and mailbox Q&A are backed by Meilisearch"
      ]
    }
