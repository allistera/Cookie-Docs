    "views": [
      {
        "id": "delivery",
        "label": "Delivery path",
        "focus": [
          "sender",
          "routing",
          "ingest",
          "store",
          "forward",
          "mailbox"
        ],
        "note": "Forwarding to the real mailbox is the primary outcome; nothing on this path waits for AI."
      },
      {
        "id": "durable-state",
        "label": "Durable state",
        "focus": [
          "ingest",
          "store",
          "blob",
          "db"
        ],
        "note": "The storage transaction applies label rules and creates the pending AI row."
      },
      {
        "id": "best-effort-ai",
        "label": "Best-effort AI",
        "focus": [
          "forward",
          "enrich",
          "classify",
          "recovery",
          "db"
        ],
        "note": "Classification runs after delivery; a 15-minute cron retries stale pending rows."
      }
    ],
    "legend": {
      "entries": {
        "backend": {
          "label": "Worker logic"
        },
        "messagebus": {
          "label": "Cron trigger"
        },
        "database": {
          "label": "Postgres"
        }
      }
    }
  },
