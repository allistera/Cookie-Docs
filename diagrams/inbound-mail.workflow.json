    },
    {
      "id": "invoke-worker",
      "from": "routing",
      "to": "ingest",
      "label": "invokes Worker"
    },
    {
      "id": "parse-store",
      "from": "ingest",
      "to": "store",
      "variant": "emphasis"
    },
    {
      "id": "store-forward",
      "from": "store",
      "to": "forward",
      "label": "stored safely",
      "variant": "emphasis"
    },
    {
      "id": "deliver",
      "from": "forward",
      "to": "mailbox",
      "label": "original email",
      "variant": "emphasis"
    },
    {
      "id": "upload-attachments",
      "from": "ingest",
      "to": "blob",
      "label": "attachments",
      "variant": "dashed",
      "role": "async"
    },
    {
      "id": "write-rows",
      "from": "store",
      "to": "db",
      "label": "Hyperdrive"
    },
    {
      "id": "start-enrichment",
      "from": "forward",
      "to": "enrich",
      "label": "waitUntil",
      "variant": "dashed",
      "role": "async"
    },
    {
      "id": "retry-stale",
      "from": "recovery",
      "to": "enrich",
      "label": "retries stale AI rows",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "call-model",
      "from": "enrich",
      "to": "classify",
      "label": "labels · spam · priority"
    },
    {
      "id": "accepted-state",
      "from": "enrich",
      "to": "db",
      "label": "accepted AI state",
      "role": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Forwarding first",
      "items": [
        "Storage, attachments, AI, and monitoring never intentionally block delivery",
        "Permanent forwarding errors are accepted only once the message is stored"
      ]
    },
    {
      "dot": "rose",
      "title": "Local policy over model output",
      "items": [
        "Labels kept only at confidence ≥ 0.70",
        "Spam moves automatically only at score ≥ 0.98",
        "Rules run deterministically inside the storage transaction"
      ]
    },
    {
      "dot": "amber",
      "title": "Recovery",
      "items": [
        "A 15-minute cron retries up to three stale pending/failed AI rows",
        "Recovery never forwards the message again"
      ]
    }
  ]
}