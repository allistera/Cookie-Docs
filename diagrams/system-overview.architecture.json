  "cards": [
    {
      "dot": "cyan",
      "title": "Ownership",
      "items": [
        "Cookie-Web owns the schema and the Vercel API",
        "Cookie-Worker owns everything outside a request/response cycle",
        "Cookie-iOS is a pure client of the Cookie-Web API"
      ]
    },
    {
      "dot": "emerald",
      "title": "Shared state, not shared code",
      "items": [
        "No RPC or shared library between the two runtimes",
        "Both halves coordinate only through the Postgres schema",
        "Workers reach Postgres through Hyperdrive"
      ]
    },
    {
      "dot": "amber",
      "title": "Deployment",
      "items": [
        "Cookie-Web and Cookie-Worker deploy independently",
        "Migrations need coordination when shared state changes"
      ]
    }
  ]
